[WUDFRD_ServiceInstall]
DisplayName=%WudfRdDisplayName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\WUDFRd.sys

[VirtualSerial_Umdf_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%13%\Virtualserial2um.dll

[SetDeviceType_AddReg]
HKR,,DeviceType,0x10001,0x0000001b

[Port5_AddReg]
HKR,,PortName,0x00000000,"COM5"
[Port6_AddReg]
HKR,,PortName,0x00000000,"COM6"
[Port7_AddReg]
HKR,,PortName,0x00000000,"COM7"
[Port8_AddReg]
HKR,,PortName,0x00000000,"COM8"
[Port9_AddReg]
HKR,,PortName,0x00000000,"COM9"

[UMDriverCopy]
Virtualserial2um.dll

