; GPS Virtual Serial test driver package
; Based on Microsoft's VirtualSerial2 UMDF 2 sample.
; TEST/DEVELOPMENT BUILD ONLY.

[Version]
Signature="$Windows NT$"
Class=Ports
ClassGuid={4D36E978-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderString%
CatalogFile=WUDF.cat
DriverVer=10/02/2026,0.6.0.0
PnpLockdown=1

[Manufacturer]
%ManufacturerString%=GPSModels,NT$ARCH$.10.0...17134,NT$ARCH$.10.0...22000

[GPSModels.NT$ARCH$.10.0...17134]
%Port5Name%=GPSVCOM5_Install,ROOT\GPSVCOM5
%Port6Name%=GPSVCOM6_Install,ROOT\GPSVCOM6
%Port7Name%=GPSVCOM7_Install,ROOT\GPSVCOM7
%Port8Name%=GPSVCOM8_Install,ROOT\GPSVCOM8
%Port9Name%=GPSVCOM9_Install,ROOT\GPSVCOM9

[GPSModels.NT$ARCH$.10.0...22000]
%Port5Name%=GPSVCOM5_Install_Win11,ROOT\GPSVCOM5
%Port6Name%=GPSVCOM6_Install_Win11,ROOT\GPSVCOM6
%Port7Name%=GPSVCOM7_Install_Win11,ROOT\GPSVCOM7
%Port8Name%=GPSVCOM8_Install_Win11,ROOT\GPSVCOM8
%Port9Name%=GPSVCOM9_Install_Win11,ROOT\GPSVCOM9

[DestinationDirs]
DefaultDestDir=13

[SourceDisksFiles]
Virtualserial2um.dll=1

[SourceDisksNames]
1=%MediaDescription%

[GPSVCOM5_Install_Win11.NT]
CopyFiles=UMDriverCopy
Include=WUDFRD.inf
Needs=WUDFRD.NT
[GPSVCOM5_Install_Win11.NT.hw]
AddReg=SetDeviceType_AddReg,Port5_AddReg
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
[GPSVCOM5_Install_Win11.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services
[GPSVCOM5_Install_Win11.NT.Wdf]
UmdfService=VirtualSerial,VirtualSerial_Umdf_Install
UmdfServiceOrder=VirtualSerial
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfFsContextUsePolicy=CannotUseFsContexts

